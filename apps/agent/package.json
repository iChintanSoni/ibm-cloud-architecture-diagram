{
  "name": "@icad/agent",
  "private": true,
  "version": "0.0.0",
  "description": "Deep Agents runtime driving @icad/mcp end-to-end from natural language, exposed over A2A (apps/agent/docs/agent-runtime.md).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "icad-agent-cli": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/a2aServer.js",
    "cli": "node dist/cli/main.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@icad/mcp": "workspace:*",
    "@langchain/core": "^1.2.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/ollama": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-js": "^2.6.2",
    "deepagents": "^1.12.2",
    "express": "^5.1.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
