{
  "name": "@icad/mcp",
  "version": "0.0.0",
  "description": "MCP server exposing ICAD's core/api authoring toolset to agents (docs/08-agent-integration.md).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "icad-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@icad/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsdom": "^29.1.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
