{
  "name": "icad",
  "private": true,
  "version": "0.0.0",
  "description": "IBM Cloud Architecture Diagrams — editor monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev": "pnpm --filter @icad/web dev",
    "test": "pnpm -r test",
    "test:perf": "pnpm --filter @icad/core test:perf",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "prepare": "husky",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@prettier/plugin-xml": "3.4.2",
    "@types/node": "^26.1.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "15.5.2",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
